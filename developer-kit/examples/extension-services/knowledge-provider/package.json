{
  "name": "example-knowledge-provider",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [{
      "id": "example-knowledge-provider",
      "path": "./index.js",
      "activation": "startup",
      "manifest": {
        "schemaVersion": 1,
        "name": "Example Knowledge Provider",
        "version": "1.0.0",
        "author": { "name": "Mortise Developer Kit" },
        "description": "Deterministic local knowledge capability for composition examples.",
        "permissions": [],
        "provides": {
          "knowledge.read": {
            "version": "1.0.0",
            "scope": "workspace",
            "service": {
              "operations": {
                "read": {
                  "inputSchema": { "type": "object", "required": ["topic"], "properties": { "topic": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
                  "outputSchema": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } }, "additionalProperties": false }
                }
              }
            }
          }
        }
      }
    }]
  }
}
