{
  "name": "mortise",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "User-extensible desktop agent platform",
  "type": "module",
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "@vscode/ripgrep",
    "electron",
    "electron-winstaller",
    "esbuild",
    "koffi",
    "protobufjs",
    "sharp"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "pi/packages/*",
    "!apps/online-docs"
  ],
  "scripts": {
    "test": "bun run test:unit && bun run test:isolated",
    "test:unit": "bun test",
    "test:isolated": "bun run scripts/reap-orphaned-processes.ts --apply && bun run scripts/run-isolated-tests.ts",
    "reap:orphaned-processes": "bun run scripts/reap-orphaned-processes.ts",
    "prune:build-cache": "bun run scripts/prune-build-cache.ts",
    "test:electron:chat-real": "bun run scripts/e2e/electron-chat/run.ts",
    "test:ui-validation:electron": "bun run scripts/e2e/ui-validation/run.ts",
    "test:ui-validation:extension": "bun run scripts/e2e/ui-validation/extension.ts",
    "test:ui-validation:extension:v2": "bun run scripts/e2e/ui-validation/extension-v2.ts",
    "test:ui-validation:migrated-extensions": "bun run scripts/e2e/ui-validation/migrated-extensions.ts",
    "test:ui-validation:recovery": "bun run scripts/e2e/ui-validation/recovery.ts",
    "test:ui-validation:raw-host-smoke": "bun run scripts/e2e/ui-validation/raw-host-smoke.ts",
    "test:ui-validation:stability": "bun run scripts/e2e/ui-validation/stability.ts",
    "test:ui-validation:runtime-contract": "bun run scripts/e2e/ui-validation/runtime-contract.ts",
    "test:ui-validation:surface-parity": "bun run scripts/e2e/ui-validation/surface-parity.ts",
    "test:ui-flows": "bun run scripts/e2e/ui-flows/run.ts",
    "test:ui-validation:session-publication": "bun run scripts/e2e/ui-validation/session-publication.ts",
    "test:ui-validation:session-settlement": "bun run scripts/e2e/ui-validation/session-settlement.ts",
    "mortise-ui": "bun run scripts/mortise-ui/cli.ts",
    "mortise-logs": "bun run scripts/mortise-logs/cli.ts",
    "test:mortise-logs": "bun test scripts/mortise-logs/__tests__",
    "test:mortise-ui": "cd scripts/mortise-ui && bun test --timeout 60000 __tests__",
    "module:catalog": "bun run scripts/project-modules/cli.ts catalog",
    "module:lint": "bun run scripts/project-modules/cli.ts lint",
    "test:project-modules": "bun test scripts/project-modules/__tests__",
    "test:ui-validation:fast": "bun test --isolate packages/shared/src/ui-validation/__tests__ scripts/mortise-ui/__tests__ apps/electron/src/main/ui-validation/__tests__ apps/electron/src/renderer/ui-validation/__tests__ apps/electron/src/renderer/components/extensions packages/shared/src/protocol/__tests__/extension-ui-validation.test.ts packages/server-core/src/handlers/pi-extension-bridge.test.ts scripts/build/__tests__/ui-validation-boundary.test.ts",
    "typecheck": "bun run typecheck:shared",
    "typecheck:shared": "cd packages/shared && bun run tsc --noEmit",
    "typecheck:all": "cd packages/core && bun run tsc --noEmit && cd ../shared && bun run tsc --noEmit && cd ../server-core && bun run tsc --noEmit && cd ../server && bun run tsc --noEmit && cd ../session-tools-core && bun run tsc --noEmit && cd ../../apps/electron && bun run typecheck && cd ../../packages/ui && bun run tsc --noEmit && cd ../../apps/webui && bun run typecheck",
    "server:start": "bun run packages/server/src/index.ts",
    "server:dev": "portmux start --project packages/server",
    "server:dev:runtime": "MORTISE_DEBUG=true MORTISE_BUNDLED_ASSETS_ROOT=$PWD/apps/electron bun run packages/server/src/index.ts",
    "server:dev:raw": "bun run server:build:subprocess:if-needed && bun run server:dev:runtime",
    "server:build": "bun run scripts/build-server.ts",
    "server:build:linux-x64": "bun run scripts/build-server.ts --platform=linux --arch=x64 --compress",
    "server:build:linux-arm64": "bun run scripts/build-server.ts --platform=linux --arch=arm64 --compress",
    "server:build:darwin-arm64": "bun run scripts/build-server.ts --platform=darwin --arch=arm64 --compress",
    "server:build:darwin-x64": "bun run scripts/build-server.ts --platform=darwin --arch=x64 --compress",
    "typecheck:electron": "cd apps/electron && bun run typecheck",
    "test:shared:models-pi": "cd packages/shared && bun test tests/models-pi.test.ts",
    "test:shared:config": "bun run scripts/run-isolated-tests.ts packages/shared/src/config/__tests__/*.test.ts",
    "test:shared:all": "bun run test:shared:models-pi && bun run test:shared:config",
    "test:oauth-e2e": "bun test ./packages/shared/src/auth/__tests__/oauth.e2e.ts",
    "test:doc-tools": "bun run scripts/build/run-doc-tool-tests.ts",
		"test:build-validation": "bun test --path-ignore-patterns='output/**' scripts/build/__tests__/production-bundle-validation.test.ts scripts/build/__tests__/package-artifact-cache.test.ts scripts/build/__tests__/workspace-package-graph.test.ts scripts/build/__tests__/headless-runtime-boundary.test.ts scripts/build/__tests__/bundle-portability.test.ts scripts/build/__tests__/build-block-cache.test.ts scripts/build/__tests__/developer-kit-build-manifest.test.ts scripts/build/__tests__/developer-kit-archive.test.ts scripts/build/__tests__/dev-build-freshness.test.ts scripts/build/__tests__/electron-build-cache.test.ts scripts/build/__tests__/build-source-snapshot.test.ts scripts/build/__tests__/offline-developer-kit-installer.test.ts scripts/build/__tests__/renderer-entry-budget.test.ts scripts/build/__tests__/build-cache-prune.test.ts",
    "validate:production-node-bundles": "bun run scripts/build/validate-production-node-bundles.ts",
    "validate:dev": "bun run validate:production-node-bundles && bun run typecheck:all && bun run test:shared:all && bun run test:doc-tools",
    "validate:production-bundles": "bun run scripts/build/validate-production-bundles.ts",
    "validate:ci": "bun run module:lint && bun run validate:dev && bun run test:build-validation && bun run validate:production-bundles && bun run test:ui-validation:fast && bun run lint:i18n:parity && bun run lint:i18n:sorted",
    "pi:install": "npm --prefix pi ci --ignore-scripts",
    "pi:build": "npm --prefix pi run build:workspace && bun run scripts/build/write-pi-build-provenance.ts",
    "pi:build:binary": "npm --prefix pi/packages/coding-agent run build:workspace:binary && bun run scripts/build/write-pi-build-provenance.ts --binary",
    "pi:check": "bun run scripts/build/check-pi-freshness.ts && npm --prefix pi run check",
    "pi:test": "cd pi && bash ./test.sh",
    "bootstrap": "bun run pi:install && bun run pi:build && bun run pi:build:binary && bun install",
    "bootstrap:ci": "bun run pi:install && bun run pi:build && bun run pi:build:binary && bun install --frozen-lockfile",
    "validate:monorepo": "bun run pi:build && bun run pi:check && bun run pi:test && bun run validate:ci",
    "lint:electron": "cd apps/electron && bun run lint",
    "lint:shared": "cd packages/shared && npx eslint .",
    "lint:session-tools-core": "cd packages/session-tools-core && npx eslint .",
    "lint:session-mcp-server": "cd packages/session-mcp-server && npx eslint .",
    "lint:ui": "cd packages/ui && npx eslint .",
    "lint:webui": "cd apps/webui && bun run lint",
    "lint:i18n:parity": "bun run scripts/check-i18n-parity.ts",
    "sort-locales": "bun scripts/sort-locales.ts",
    "lint:i18n:sorted": "bun scripts/sort-locales.ts --check",
    "lint": "bun run lint:electron && bun run lint:shared && bun run lint:session-tools-core && bun run lint:session-mcp-server && bun run lint:ui && bun run lint:webui",
    "link": "bun link",
    "electron:clean": "bun run scripts/electron-clean.ts",
    "electron:build:main": "bun run scripts/electron-build-main.ts",
    "electron:build:preload": "bun run scripts/electron-build-preload.ts",
    "electron:build:renderer": "bun run scripts/electron-build-renderer.ts",
    "electron:build:resources": "bun run scripts/electron-build-resources.ts",
    "build:wa-worker": "bun run scripts/build-wa-worker.ts",
    "electron:build:assets": "cd apps/electron && bun scripts/copy-assets.ts",
    "electron:build:packaging-inputs": "bun run scripts/build/stage-electron-packaging-inputs.ts",
    "build:seed-uv-toolchain": "bun run scripts/build/seed-current-uv-toolchain.ts",
    "electron:build:source": "bun run electron:build:main && bun run electron:build:preload && bun run electron:build:renderer && bun run electron:build:resources && bun run electron:build:packaging-inputs",
    "electron:build": "bun run scripts/build/produce-electron-build.ts",
    "electron:start": "bun run scripts/electron-start.ts",
    "desktop:tool": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/mortise-dev-tool/MortiseDesktopTool.ps1",
    "electron:dev": "portmux start --project apps/electron",
    "electron:dev:raw": "bun run scripts/electron-dev.ts",
    "sync-secrets": "bash scripts/sync-secrets.sh",
    "fresh-start": "bun run scripts/fresh-start.ts",
    "fresh-start:token": "bun run scripts/fresh-start.ts --token-only",
    "print:system-prompt": "bun run packages/shared/src/prompts/print-system-prompt.ts",
    "browser-tool": "bun run scripts/browser-tool.ts",
    "electron:dist": "bun run scripts/build/package-electron.ts --target default",
    "electron:dist:mac": "bun run scripts/build/package-electron.ts --target mac",
    "electron:dist:win": "bun run scripts/build/package-electron.ts --target win",
    "electron:dist:linux": "bun run scripts/build/package-electron.ts --target linux",
    "electron:dist:dev:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false bun run scripts/build/package-electron.ts --target mac --development",
    "electron:dist:dev:win": "bun run scripts/build/package-electron.ts --target win --development",
    "electron:dist:dev:linux": "bun run scripts/build/package-electron.ts --target linux --development",
    "developer-kit:dist:win": "bun run scripts/build-developer-kit.ts",
    "developer-kit:smoke:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-developer-kit.ps1",
    "playground:dev": "portmux start --project apps/electron/src/renderer/playground",
    "playground:dev:raw": "vite dev --config apps/electron/vite.config.ts --open /playground.html",
    "playground:inventory": "bun run scripts/playground-ui-inventory-cli.ts inventory --root .",
    "playground:catalog": "bun run scripts/generate-playground-ui-catalog.ts",
    "playground:coverage:bootstrap": "bun run scripts/generate-playground-ui-catalog.ts --bootstrap-coverage",
    "playground:coverage": "bun run scripts/playground-ui-inventory-cli.ts check --root . --manifest apps/electron/src/renderer/playground/ui-coverage.json",
    "test:playground:inventory": "bun test scripts/playground-ui-inventory.test.ts apps/electron/src/renderer/playground/__tests__/scene-runtime.test.ts",
    "viewer:dev": "lsof -ti:5174 | xargs kill -9 2>/dev/null; vite dev --config apps/viewer/vite.config.ts --open /s/tz5-13I84pwK_he",
    "viewer:typecheck": "cd apps/viewer && bun run typecheck",
    "viewer:build": "vite build --config apps/viewer/vite.config.ts",
    "viewer:preview": "vite preview --config apps/viewer/vite.config.ts",
    "webui:dev": "portmux start --project apps/webui",
    "webui:clean": "rm -rf apps/webui/dist",
    "webui:build": "vite build --config apps/webui/vite.config.ts",
    "webui:typecheck": "cd apps/webui && bun run typecheck",
    "server:build:subprocess": "cd packages/session-mcp-server && bun run build",
    "server:build:subprocess:if-needed": "bun run scripts/build-session-mcp-server.ts",
    "server:prod": "bun run server:build:subprocess && MORTISE_UI_VALIDATION_BUILD=0 bun run webui:build && MORTISE_UI_VALIDATION_BUILD=0 MORTISE_WEBUI_DIR=apps/webui/dist MORTISE_BUNDLED_ASSETS_ROOT=$PWD/apps/electron bun run packages/server/src/index.ts",
    "server:dev:webui": "MORTISE_WEBUI_DIR=apps/webui/src bun run server:dev:raw",
    "marketing:dev": "vite dev --config apps/marketing/vite.config.ts",
    "marketing:build": "vite build --config apps/marketing/vite.config.ts",
    "marketing:preview": "vite preview --config apps/marketing/vite.config.ts",
    "docs:dev": "cd apps/online-docs && npm install && npx mintlify dev",
    "build": "bun run electron:build",
    "release": "bun run scripts/release.ts",
    "check-version": "bun run scripts/check-version.ts",
    "oss:sync": "bun run scripts/oss-sync.ts",
    "prepare": "husky"
  },
