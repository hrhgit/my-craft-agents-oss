{
  "name": "@mortise/bundled-pi-extensions",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      {
        "id": "mortise-browser",
        "path": "./browser.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Browser",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Connects the Agent to Mortise's session-owned browser.",
          "capabilities": ["browser.command"],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 1,
          "title": "Mortise Browser",
          "description": "Connects the Agent to Mortise's session-owned browser.",
          "category": "agent"
        }
      },
      {
        "id": "mortise-messaging",
        "path": "./messaging.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Messaging",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Lets the Agent inspect and disconnect session messaging channels.",
          "capabilities": ["messaging.session"],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 1,
          "title": "Mortise Messaging",
          "description": "Lets the Agent inspect and disconnect session messaging channels.",
          "category": "agent"
        }
      },
      {
        "id": "conversation-board",
        "path": "./conversation-board/index.js",
        "activation": "startup",
        "manifest": { "schemaVersion": 1, "name": "Conversation Board", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "A session-owned conversation workboard.", "dependencies": { "mortise-ui-kit": "^1.0.0" }, "permissions": [] },
        "ui": { "schemaVersion": 2, "title": "Conversation Board", "description": "Complex session UI composed from an extension component module.", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "frontends": [{ "id": "board", "entry": "./dist/ui/board.js", "styles": ["./dist/ui/board.css"], "surface": "conversation.timeline.before", "mode": "append", "scope": "session" }, { "id": "toolbar", "entry": "./dist/ui/toolbar.js", "styles": ["./dist/ui/board.css"], "surface": "composer.toolbar", "mode": "append", "scope": "session" }, { "id": "settings", "entry": "./dist/ui/settings.js", "styles": ["./dist/ui/board.css"], "surface": "settings.page", "mode": "append", "scope": "workspace", "page": { "id": "board", "title": "Conversation Board", "icon": "layout-dashboard", "order": 12 } }] }
      },
      {
        "id": "mortise-ui-kit-compact",
        "path": "./mortise-ui-kit-compact/index.js",
        "activation": "startup",
        "manifest": { "schemaVersion": 1, "name": "Mortise UI Kit Compact", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "A spacing and control decoration for the UI kit.", "dependencies": { "mortise-ui-kit": "^1.0.0" }, "permissions": [] },
        "ui": { "schemaVersion": 2, "title": "Mortise UI Kit Compact", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "overrides": [{ "id": "compact-components", "target": { "extensionId": "mortise-ui-kit", "kind": "module", "id": "components" }, "mode": "decorate", "entry": "./dist/compact-components.js", "styles": ["./dist/compact.css"] }] }
      },
      {
        "id": "conversation-board-replace",
        "path": "./conversation-board-replace/index.js",
        "activation": "startup",
        "manifest": { "schemaVersion": 1, "name": "Conversation Board Replace", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "Replaces the board toolbar while retaining its session contract.", "dependencies": { "conversation-board": "^1.0.0" }, "permissions": [] },
        "ui": { "schemaVersion": 2, "title": "Conversation Board Replace", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "overrides": [{ "id": "board-replace", "target": { "extensionId": "conversation-board", "kind": "frontend", "id": "toolbar" }, "mode": "replace", "entry": "./dist/replace-toolbar.js", "styles": ["./dist/replace.css"] }] }
      },
      {
        "id": "conversation-board-tweak",
        "path": "./conversation-board-tweak/index.js",
        "activation": "startup",
        "manifest": { "schemaVersion": 1, "name": "Conversation Board Tweak", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "Continues modifying the board replacement extension.", "dependencies": { "conversation-board-replace": "^1.0.0" }, "permissions": [] },
        "ui": { "schemaVersion": 2, "title": "Conversation Board Tweak", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "overrides": [{ "id": "board-tweak", "target": { "extensionId": "conversation-board-replace", "kind": "frontend", "id": "board-replace" }, "mode": "replace", "entry": "./dist/tweak-toolbar.js", "styles": ["./dist/tweak.css"] }] }
      }
    ]
  }
}
