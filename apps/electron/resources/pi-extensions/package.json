{
  "name": "@mortise/bundled-pi-extensions",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      {
        "id": "mortise-browser",
        "path": "./browser.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Browser",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Connects the Agent to Mortise's session-owned browser.",
          "capabilities": ["browser.command"],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 1,
          "title": "Mortise Browser",
          "description": "Connects the Agent to Mortise's session-owned browser.",
          "category": "agent"
        }
      },
      {
        "id": "mortise-messaging",
        "path": "./messaging.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Messaging",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Lets the Agent inspect and disconnect session messaging channels.",
          "capabilities": ["messaging.session"],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 1,
          "title": "Mortise Messaging",
          "description": "Lets the Agent inspect and disconnect session messaging channels.",
          "category": "agent"
        }
      },
      {
        "id": "mortise-permissions",
        "path": "./mortise-permissions/index.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Permissions",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Owns tool approval policy and its session controls.",
          "capabilities": ["ui.frontends"],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 2,
          "title": "Mortise Permissions",
          "description": "",
          "category": "agent",
          "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" },
          "frontends": [
            { "id": "toolbar", "entry": "./dist/ui/toolbar.js", "styles": ["./dist/ui/styles.css"], "surface": "composer.toolbar", "mode": "append", "scope": "session" },
            { "id": "approval", "entry": "./dist/ui/approval.js", "styles": ["./dist/ui/styles.css"], "surface": "composer.above", "mode": "append", "scope": "session" }
          ]
        }
      },
      {
        "id": "mortise-web-search",
        "path": "./web-search.js",
        "activation": "startup",
        "manifest": {
          "schemaVersion": 1,
          "name": "Mortise Web Search",
          "version": "1.0.0",
          "author": { "name": "Mortise" },
          "description": "Fallback public web search for models without native search.",
          "capabilities": [],
          "permissions": []
        },
        "ui": {
          "schemaVersion": 1,
          "title": "网页搜索",
          "description": "当当前模型不支持原生搜索时提供有限后备搜索。",
          "category": "search"
        }
      }
    ]
  }
}
