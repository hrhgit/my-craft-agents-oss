{
  "name": "conversation-board",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [{
      "id": "conversation-board",
      "path": "./index.js",
      "activation": "startup",
      "manifest": { "schemaVersion": 1, "name": "Conversation Board", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "A session-owned conversation workboard.", "dependencies": { "mortise-ui-kit": "^1.0.0" }, "permissions": [] },
      "ui": { "schemaVersion": 2, "title": "Conversation Board", "description": "Complex session UI composed from an extension component module.", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "frontends": [{ "id": "board", "entry": "./dist/ui/board.js", "styles": ["./dist/ui/board.css"], "surface": "conversation.timeline.before", "mode": "append", "scope": "session" }, { "id": "toolbar", "entry": "./dist/ui/toolbar.js", "styles": ["./dist/ui/board.css"], "surface": "composer.toolbar", "mode": "append", "scope": "session" }, { "id": "settings", "entry": "./dist/ui/settings.js", "styles": ["./dist/ui/board.css"], "surface": "settings.page", "mode": "append", "scope": "workspace", "page": { "id": "board", "title": "Conversation Board", "icon": "layout-dashboard", "order": 12 } }] }
    }]
  }
}
