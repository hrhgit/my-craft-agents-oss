{
  "name": "conversation-board-replace",
  "private": true,
  "type": "module",
  "pi": { "extensions": [{
    "id": "conversation-board-replace",
    "path": "./index.js",
    "activation": "startup",
    "manifest": { "schemaVersion": 1, "name": "Conversation Board Replace", "version": "1.0.0", "author": { "name": "Mortise" }, "description": "Replaces the board toolbar while retaining its session contract.", "dependencies": { "conversation-board": "^1.0.0" }, "permissions": [] },
    "ui": { "schemaVersion": 2, "title": "Conversation Board Replace", "category": "ui", "compatibility": { "uiApi": "^2.0.0", "mortise": ">=0.1.0 <0.2.0" }, "overrides": [{ "id": "board-replace", "target": { "extensionId": "conversation-board", "kind": "frontend", "id": "toolbar" }, "mode": "replace", "entry": "./dist/replace-toolbar.js", "styles": ["./dist/replace.css"] }] }
  }] }
}
